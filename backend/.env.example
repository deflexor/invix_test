# PostgreSQL. Default: local PostgreSQL in Docker (`docker compose up -d postgres`
# from the repo root). For Supabase use its transaction pooler (port 6543) and
# append ?sslmode=require.
DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# MinIO S3 (local dev: `docker compose up -d minio createbucket` from the repo root)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=products

# Telegram bot (@BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-token
# Comma-separated Telegram user IDs that may create products (get yours from @userinfobot)
TELEGRAM_ADMIN_IDS=

# Optional: proxy for api.telegram.org (http://... or socks5://...) if Telegram is blocked.
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# Public https URL of the Next.js app opened by the Mini App button
MINIAPP_URL=https://your-public-nextjs-url.example.org

# Public base URL of this API (used to build product image URLs)
PUBLIC_API_URL=http://localhost:8000

# Optional webhook mode (multi-instance bot). Empty/unset = long polling.
# TELEGRAM_WEBHOOK_URL=https://your-public-api-url.example.org/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=any-random-string
# WEBHOOK_SERVER_PORT=8080
